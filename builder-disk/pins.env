#
# What the builder microVM's root disk is made from. Every download is checked against the sha256 beside it, so the
# same inputs give the same disk. A release of the disk changes a value here and BUILDER_DISK_VERSION in pins.ts.
# Take each sha256 from the upstream release page, then check it again against the file you downloaded.
DEBIAN_SNAPSHOT=20260701T000000Z
DEBIAN_SUITE=bookworm
